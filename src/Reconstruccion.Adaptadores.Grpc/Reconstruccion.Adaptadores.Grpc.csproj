<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Reconstruccion.Aplicacion\Reconstruccion.Aplicacion.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Core.Api" Version="2.85.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Protobuf Include="..\..\contracts\proto\reconstruccion\v1\caracterizacion.proto" GrpcServices="Server" ProtoRoot="..\..\contracts\proto\reconstruccion\v1" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\contracts\proto\reconstruccion\v1\proyectos.proto" GrpcServices="Server" ProtoRoot="..\..\contracts\proto\reconstruccion\v1" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\contracts\proto\reconstruccion\v1\consultas.proto" GrpcServices="Server" ProtoRoot="..\..\contracts\proto\reconstruccion\v1" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\contracts\proto\reconstruccion\v1\cierre.proto" GrpcServices="Client" ProtoRoot="..\..\contracts\proto\reconstruccion\v1" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\contracts\proto\reconstruccion\v1\comunes.proto" ProtoRoot="..\..\contracts\proto\reconstruccion\v1" GrpcServices="None" />
  </ItemGroup>
</Project>